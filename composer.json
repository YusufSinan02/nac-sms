{
    "name": "yusufsinan/nac-sms",
    "description": "NAC Telecom SMS API PHP/Laravel client",
    "type": "library",
    "license": "MIT",
    "keywords": ["sms", "nac", "telecom", "otp", "laravel"],
    "autoload": {
        "psr-4": {
            "NacSms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NacSms\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NacSms\\NacSmsServiceProvider"
            ],
            "aliases": {
                "NacSms": "NacSms\\Facades\\NacSms"
            }
        }
    },
    "minimum-stability": "stable"
}
